{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"name": "demaree-emdash-poc",
	"main": "./src/worker.ts",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "demaree-emdash-poc",
			"database_id": "573cf7d8-e8b7-4621-b802-3b37317e9440"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "demaree-emdash-poc-media"
		}
	],
	"send_email": [
		{
			"name": "EMAIL",
			"allowed_sender_addresses": [
				"noreply@demaree.me"
			]
		}
	],
	"triggers": {
		"crons": [
			"* * * * *"
		]
	},
	"observability": {
		"enabled": true
	},
	"account_id": "6f85781cbcce7fb538d337cdd56faee3",
	"vars": {
		"EMDASH_SITE_URL": "https://demaree.me"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "e11083a3ed6e4fcca5937af316917fd2"
		}
	]
}
