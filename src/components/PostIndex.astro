---
import { formatDate, postTopicId, type PostEntry, type TopicEntry } from '../lib/taxonomy';
import { emdashPostUrl } from '../lib/emdash-post';

interface Props {
  posts: PostEntry[];
  topics: TopicEntry[];
  label?: string;
}

const { posts, topics, label = 'Posts' } = Astro.props;
const topicTitles = new Map(topics.map((topic) => [topic.id, topic.data.title]));

function categoryLabel(post: PostEntry) {
  return topicTitles.get(postTopicId(post)) ?? 'Notebook';
}
---

<section class="post-index" aria-label={label}>
  {posts.length === 0 ? (
    <p class="index-empty">No published posts in this collection yet.</p>
  ) : (
    posts.map((post) => (
      <article class="index-entry">
        <div class="index-entry__meta">
          <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
          <span>{categoryLabel(post)}</span>
        </div>
        <div class="index-entry__body">
          <h2><a href={emdashPostUrl(post)}>{post.data.title}</a></h2>
          <p>{post.data.description}</p>
        </div>
        <a class="index-entry__arrow" href={emdashPostUrl(post)} aria-label={`Read ${post.data.title}`}>→</a>
      </article>
    ))
  )}
</section>
