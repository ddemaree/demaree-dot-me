---
import SocialLinks from './SocialLinks.astro';
import { withBitsAndLettersUtm } from '../lib/bits-and-letters-utm.mjs';

const consultingUrl = withBitsAndLettersUtm('https://www.bitsandletters.com/', 'footer-consulting');
const creditUrl = withBitsAndLettersUtm('https://www.bitsandletters.com/', 'brand-attribution', 'logo');
---

<footer class="site-footer content-inset">
  <div class="site-footer__main">
    <a class="site-footer__identity" href="/">
      <span><img src="/images/redesign/site-mark.svg" alt="" width="48" height="48" /></span>
      David Demaree
    </a>
    <nav class="site-footer__links" aria-label="Footer">
      <a href="/about/">About David</a>
      <a href="/blog/">All posts</a>
      <a href={consultingUrl}>Consulting</a>
      <a href="mailto:david@demaree.me">Contact</a>
    </nav>
    <SocialLinks />
  </div>
  <div class="site-footer__credit">
    <bnl-logo theme="on-dark" source="demaree.me"><a href={creditUrl}>Bits&amp;Letters</a></bnl-logo>
    <a href="/feed/">RSS feed</a>
  </div>
</footer>

<script is:inline type="module" src="https://unpkg.com/bitsandletters-logo@0.1.2/dist/index.js"></script>
