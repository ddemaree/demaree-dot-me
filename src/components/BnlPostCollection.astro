---
import { getLiveCollection } from 'astro:content';
import HomePostCards from './HomePostCards.astro';

const result = await getLiveCollection('bnlPosts', { limit: 3, includeImages: true });
const posts = (result.entries ?? []).map(({ data }) => ({
  title: data.title,
  description: data.description,
  href: data.url,
  date: data.publishedAt,
  image: data.image,
}));

if (!result.error) Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');
---

<section class="home-section" aria-labelledby="bnl-posts-heading">
  <h2 id="bnl-posts-heading" class="section-heading">From the Bits&amp;Letters Blog</h2>
  {result.error ? <p>Bits&amp;Letters posts are temporarily unavailable.</p> : posts.length ? <HomePostCards posts={posts} /> : <p>No posts are available yet.</p>}
  <a href="https://www.bitsandletters.com/ideas" class="arrow-link">More posts from Bits&amp;Letters<span class="arrow" aria-hidden="true"></span></a>
</section>
