---
import { withBitsAndLettersUtm } from '../lib/bits-and-letters-utm.mjs';
import { getNavTopics } from '../lib/taxonomy';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
let navTopics: Awaited<ReturnType<typeof getNavTopics>> = [];
try {
  navTopics = await getNavTopics();
} catch (error) {
  console.error('Unable to load navigation topics from EmDash.', error);
  if ((Astro.response.status ?? 200) < 400) Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}
const links = [
  { href: '/about/', label: 'About David', current: path === '/about' },
  ...navTopics.map((topic) => ({
    href: `/topics/${topic.id}/`,
    label: topic.data.title,
    current: path === `/topics/${topic.id}`,
  })),
  {
    href: '/blog/',
    label: 'All Posts',
    current: path === '/blog' || path.startsWith('/p/') || path.startsWith('/labels') || path === '/topics',
  },
  { href: withBitsAndLettersUtm('https://www.bitsandletters.com/', 'header-consulting'), label: 'Consulting', current: false },
  { href: 'mailto:david@demaree.me', label: 'Contact', current: false },
];
---

<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
  <a class="site-header__brand" href="/" aria-label="David Demaree, home">
    <img src="/images/redesign/site-mark.svg" width="48" height="48" alt="" />
  </a>
  <nav class="desktop-navigation" aria-label="Main menu">
    {links.map(({ href, label, current }) => (
      <a href={href} aria-current={current ? (path === href.slice(0, -1) ? 'page' : 'location') : undefined}>{label}</a>
    ))}
  </nav>
  <button class="theme-toggle" type="button" role="switch" data-theme-toggle hidden aria-label="Dark mode" aria-checked="false">
    <span aria-hidden="true" class="theme-toggle__light">☼</span>
    <span aria-hidden="true" class="theme-toggle__dark">☾</span>
  </button>
  <button class="site-header__menu" type="button" popovertarget="mobile-menu">
    Menu <img src="/images/redesign/menu.svg" alt="" width="25" height="20" />
  </button>
  <div id="mobile-menu" popover>
    <nav aria-label="Mobile menu">
      {links.map(({ href, label, current }) => (
        <a href={href} aria-current={current ? (path === href.slice(0, -1) ? 'page' : 'location') : undefined}>{label}</a>
      ))}
    </nav>
  </div>
</header>
