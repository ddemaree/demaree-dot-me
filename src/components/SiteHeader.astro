    }

    .mobile-navigation summary::-webkit-details-marker {
      display: none;
    }

    .mobile-navigation summary img {
      width: 3.5rem;
      height: 3rem;
    }

    .mobile-navigation nav {
      position: absolute;
      top: 3rem;
      right: 0;
      left: 0;
      z-index: 1;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--header-border);
      background: var(--header);
    }

    .mobile-navigation a {
      display: block;
      padding: 0.5rem;
    }*/
  }

  @media (prefers-reduced-motion: reduce) {
    .brand,
    .brand img {
      transition: none;
    }
  }

</style>
