---
import type { PostEntry } from '../lib/taxonomy';
import { emdashPostUrl, emdashSocialImage } from '../lib/emdash-post';
import HomePostCards from './HomePostCards.astro';

interface Props {
  posts: PostEntry[];
}
const { posts } = Astro.props;
const cards = posts.map(({ id, data }) => ({
  title: data.title,
  description: data.description,
  href: emdashPostUrl({ id }),
  date: data.publishedAt,
  image: emdashSocialImage(data.featured_image, Astro.locals.emdash?.getPublicMediaUrl)?.src,
  imageAlt: data.featured_image_alt ?? data.featured_image?.alt,
}));
---

<section class="home-section" aria-labelledby="recent-posts-heading">
  <h2 id="recent-posts-heading" class="section-heading">Recent blog posts</h2>
  <HomePostCards posts={cards} />
  <a href="/blog/" class="arrow-link">More posts<span class="arrow" aria-hidden="true"></span></a>
</section>
