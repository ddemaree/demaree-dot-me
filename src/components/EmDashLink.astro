---
import { sanitizeHref } from 'emdash';
import { withBitsAndLettersUtm } from '../lib/bits-and-letters-utm.mjs';

interface Props {
  node: {
    markDef: {
      _type: 'link';
      _key: string;
      href: string;
      title?: string;
      blank?: boolean;
    };
  };
}

const { node } = Astro.props;
const href = withBitsAndLettersUtm(sanitizeHref(node?.markDef?.href), 'post-body');
const blank = !href.startsWith('#') && node?.markDef?.blank;
---

<a
  href={href}
  title={node?.markDef?.title}
  target={blank ? '_blank' : undefined}
  rel={blank ? 'noopener noreferrer' : undefined}
>
  <slot />
</a>
