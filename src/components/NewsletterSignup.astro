---
import { Image } from 'astro:assets';
import johnny from '@/assets/images/redesign/johnny.png';

// Same Kit form and confirmation/PDF incentive as gitforhumans.us/#get-free-pdf.
const options = {
  settings: {
    after_subscribe: {
      action: 'message',
      success_message: "You're in! Please check your email to confirm your subscription and get your free copy of the book.",
      redirect_url: '',
    },
    analytics: {},
    powered_by: { show: false },
    recaptcha: { enabled: false },
    return_visitor: { action: 'show', custom_content: '' },
  },
  version: '5',
};
---

<section class="newsletter" aria-labelledby="newsletter-title">
  <Image src={johnny} class="newsletter__photo" width={152} alt="Johnny Cash, my French bulldog" loading="lazy" />
  <h2 id="newsletter-title">Get this guy (and David) in your inbox.</h2>
  <div class="newsletter__copy">
    <p>My weekly newsletter features reasonable-length essays on whatever’s happening in tech, AI, and design, plus links worth clicking and a photo of my dog, Johnny.</p>
    <p>Plus, everyone who signs up gets a free PDF copy of <em>Git for Humans</em>.</p>
  </div>
  <form
    class="newsletter__form seva-form formkit-form"
    aria-labelledby="newsletter-title"
    action="https://app.kit.com/forms/8590506/subscriptions"
    method="post"
    data-sv-form="8590506"
    data-uid="fcbf397a0d"
    data-format="inline"
    data-version="5"
    data-options={JSON.stringify(options)}
  >
    <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert" aria-live="polite"></ul>
    <div aria-live="polite">
      <div class="newsletter__fields" data-element="fields">
        <label for="newsletter-email">Email address</label>
        <input id="newsletter-email" type="email" name="email_address" autocomplete="email" placeholder="you@example.com" required />
        <button type="submit">Subscribe</button>
      </div>
    </div>
  </form>
</section>

<script is:inline type="module" src="https://f.convertkit.com/ckjs/ck.5.js"></script>
