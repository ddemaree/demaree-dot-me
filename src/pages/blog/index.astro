---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchivePosts from '../../components/ArchivePosts.astro';
import { paginatePosts } from '../../lib/archive-pagination';
import { getPublishedPosts, getTopics } from '../../lib/taxonomy';

export const prerender = false;

let posts: Awaited<ReturnType<typeof getPublishedPosts>>;
let topics: Awaited<ReturnType<typeof getTopics>>;
try {
  [posts, topics] = await Promise.all([getPublishedPosts(), getTopics()]);
} catch (error) {
  console.error('[EmDash] Failed to load public archive:', error);
  return new Response('Posts are temporarily unavailable. Please try again soon.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' },
  });
}

const page = paginatePosts(posts, Astro.url);
if (!page) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
---

<BaseLayout title="All Posts — David Demaree" description="Writing by David Demaree." canonical={page.canonical}>
  <ArchivePosts heading="All Posts" posts={page.posts} topics={topics} newer={page.newer} older={page.older} allPosts />
</BaseLayout>
