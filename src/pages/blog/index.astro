---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostIndex from '../../components/PostIndex.astro';
import { getPublishedPosts, getTopics, type PostEntry, type TopicEntry } from '../../lib/taxonomy';

export const prerender = false;

let posts: PostEntry[];
let topics: TopicEntry[];
try {
  [posts, topics] = await Promise.all([getPublishedPosts(), getTopics()]);
} catch (error) {
  console.error('[EmDash] Failed to load public archive:', error);
  return new Response('Posts are temporarily unavailable. Please try again soon.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}
---

<BaseLayout title="All posts — David Demaree" description="Writing by David Demaree.">
  <main id="main" class="index-shell">
    <header class="index-header">
      <p class="index-eyebrow">Index</p>
      <h1>All posts</h1>
      <p class="index-lede">
        <a href="/topics/">Topics</a>
        <span aria-hidden="true"> · </span>
        <a href="/labels/">Tags</a>
      </p>
    </header>

    <PostIndex posts={posts} topics={topics} label="All posts" />
  </main>
</BaseLayout>
