---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostIndex from '../../components/PostIndex.astro';
import {
  getPostsByTag,
  getTopics,
  tagLabelFromPosts,
} from '../../lib/taxonomy';

Astro.response.headers.set('Cache-Control', 'public, s-maxage=600, stale-while-revalidate=86400');

const slug = Astro.params.slug ?? '';
const [posts, topics] = await Promise.all([getPostsByTag(slug), getTopics()]);
const tag = tagLabelFromPosts(slug, posts);

if (posts.length === 0) {
  Astro.response.status = 404;
}

const title = posts.length > 0 ? `${tag} — David Demaree` : 'Tag not found — David Demaree';
const description =
  posts.length > 0
    ? `Posts tagged ${tag}.`
    : 'This tag does not match any published posts.';
---

<BaseLayout title={title} description={description}>
  <main id="main" class="index-shell">
    <header class="index-header">
      <p class="index-eyebrow">
        <a href="/labels/">Tags</a>
      </p>
      <h1>{posts.length > 0 ? tag : 'Tag not found'}</h1>
    </header>

    {posts.length > 0 && <PostIndex posts={posts} topics={topics} label={`Posts tagged ${tag}`} />}
  </main>
</BaseLayout>
