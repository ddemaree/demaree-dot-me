---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostIndex from '../../components/PostIndex.astro';
import {
  getPostsByTag,
  getTopics,
  tagLabelFromPosts,
} from '../../lib/taxonomy';

Astro.response.headers.set('Cache-Control', 'no-store');

const slug = Astro.params.slug ?? '';
let posts: Awaited<ReturnType<typeof getPostsByTag>> = [];
let topics: Awaited<ReturnType<typeof getTopics>> = [];
let unavailable = false;
try {
  [posts, topics] = await Promise.all([getPostsByTag(slug), getTopics()]);
  if (posts.length === 0) Astro.response.status = 404;
} catch (error) {
  console.error('Unable to load tag archive from EmDash.', error);
  Astro.response.status = 503;
  unavailable = true;
}
const tag = tagLabelFromPosts(slug, posts);
const heading = unavailable ? 'Content temporarily unavailable' : posts.length > 0 ? tag : 'Tag not found';
const title = `${heading} — David Demaree`;
const description = unavailable
  ? 'Content is temporarily unavailable. Please try again shortly.'
  : posts.length > 0
    ? `Posts tagged ${tag}.`
    : 'This tag does not match any published posts.';
---

<BaseLayout title={title} description={description}>
  <main id="main" class="index-shell">
    <header class="index-header">
      <p class="index-eyebrow">
        <a href="/labels/">Tags</a>
      </p>
      <h1>{heading}</h1>
      {unavailable && <p class="index-lede">{description}</p>}
    </header>

    {posts.length > 0 && !unavailable && <PostIndex posts={posts} topics={topics} label={`Posts tagged ${tag}`} />}
  </main>
</BaseLayout>
