---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHeader from '../../components/ArchiveHeader.astro';
import ArchivePosts from '../../components/ArchivePosts.astro';
import { paginatePosts } from '../../lib/archive-pagination';
import { getPostsByTag, getTopics, tagLabelFromPosts } from '../../lib/taxonomy';

export const prerender = false;

const slug = Astro.params.slug ?? '';
let posts: Awaited<ReturnType<typeof getPostsByTag>>;
let topics: Awaited<ReturnType<typeof getTopics>>;
try {
  [posts, topics] = await Promise.all([getPostsByTag(slug), getTopics()]);
} catch (error) {
  console.error('Unable to load tag archive from EmDash.', error);
  return new Response('Posts are temporarily unavailable. Please try again soon.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' },
  });
}

const tag = posts.length ? tagLabelFromPosts(slug, posts) : undefined;
const page = tag && paginatePosts(posts, Astro.url);
const heading = tag ?? 'Tag not found';
if (!page) Astro.response.status = 404;
---

<BaseLayout title={`${heading} — David Demaree`} description={tag ? `Posts tagged ${tag}.` : undefined} canonical={page ? page.canonical : undefined}>
  {page ? (
    <ArchivePosts heading={heading} posts={page.posts} topics={topics} newer={page.newer} older={page.older} />
  ) : (
    <main id="main" class="content-inset archive-page">
      <ArchiveHeader heading={tag ? 'Page not found' : heading} message={tag ? 'This page of the archive does not exist.' : 'This tag does not match any published posts.'} />
    </main>
  )}
</BaseLayout>
