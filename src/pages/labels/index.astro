---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHeader from '../../components/ArchiveHeader.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getTagIndex } from '../../lib/taxonomy';

Astro.response.headers.set('Cache-Control', 'no-store');

let tags: Awaited<ReturnType<typeof getTagIndex>> = [];
let unavailable = false;
try {
  tags = await getTagIndex();
} catch (error) {
  console.error('Unable to load tag index from EmDash.', error);
  Astro.response.status = 503;
  unavailable = true;
}
---

<BaseLayout
  title="Tags — David Demaree"
  description="Browse writing by David Demaree by tag."
>
  <main id="main" class="content-inset archive-page">
    <ArchiveHeader heading="Tags" current="tags" message={unavailable ? 'Content is temporarily unavailable. Please try again shortly.' : undefined} />

    <ul class="tag-index" aria-label="Tags">
      {tags.map((entry) => (
        <li>
          <a href={`/labels/${entry.slug}/`}>
            <span>{entry.tag}</span>
            <span class="tag-index__count">{entry.count}</span>
          </a>
        </li>
      ))}
    </ul>
    {!unavailable && <NewsletterSignup />}
  </main>
</BaseLayout>
