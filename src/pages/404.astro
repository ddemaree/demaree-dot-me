---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — David Demaree" description="This page could not be found." noindex>
  <main id="main" class="index-shell">
    <header class="index-header">
      <p class="index-eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="index-lede">This page may have moved or no longer exists.</p>
    </header>
    <div class="post-index index-empty">
      <p><a href="/">Go to the home page</a> or <a href="/blog/">browse all posts</a>.</p>
    </div>
  </main>
</BaseLayout>
