---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHeader from '../../components/ArchiveHeader.astro';
import ArchivePosts from '../../components/ArchivePosts.astro';
import { paginatePosts } from '../../lib/archive-pagination';
import { getPostsByTopic, getTopic, getTopics } from '../../lib/taxonomy';

export const prerender = false;

const slug = Astro.params.slug ?? '';
let topic: Awaited<ReturnType<typeof getTopic>>;
let topics: Awaited<ReturnType<typeof getTopics>>;
let posts: Awaited<ReturnType<typeof getPostsByTopic>>;
try {
  [topic, topics, posts] = await Promise.all([getTopic(slug), getTopics(), getPostsByTopic(slug)]);
} catch (error) {
  console.error('Unable to load topic archive from EmDash.', error);
  return new Response('Posts are temporarily unavailable. Please try again soon.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Cache-Control': 'no-store' },
  });
}

const page = topic && paginatePosts(posts, Astro.url);
const heading = topic?.data.title ?? 'Topic not found';
if (!page) Astro.response.status = 404;
---

<BaseLayout title={`${heading} — David Demaree`} description={topic?.data.description} canonical={page ? page.canonical : undefined}>
  {page ? (
    <ArchivePosts heading={heading} posts={page.posts} topics={topics} newer={page.newer} older={page.older} />
  ) : (
    <main id="main" class="content-inset archive-page">
      <ArchiveHeader heading={topic ? 'Page not found' : heading} message={topic ? 'This page of the archive does not exist.' : 'This topic does not exist.'} />
    </main>
  )}
</BaseLayout>
