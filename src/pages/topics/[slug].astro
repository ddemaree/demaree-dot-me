---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PostIndex from '../../components/PostIndex.astro';
import { getPostsByTopic, getTopic, getTopics } from '../../lib/taxonomy';

Astro.response.headers.set('Cache-Control', 'no-store');

const slug = Astro.params.slug ?? '';
let topic: Awaited<ReturnType<typeof getTopic>>;
let topics: Awaited<ReturnType<typeof getTopics>> = [];
let posts: Awaited<ReturnType<typeof getPostsByTopic>> = [];
let unavailable = false;
try {
  [topic, topics] = await Promise.all([getTopic(slug), getTopics()]);
  if (topic) posts = await getPostsByTopic(topic.id);
  else Astro.response.status = 404;
} catch (error) {
  console.error('Unable to load topic archive from EmDash.', error);
  Astro.response.status = 503;
  unavailable = true;
}

const heading = unavailable ? 'Content temporarily unavailable' : topic?.data.title ?? 'Topic not found';
const title = `${heading} — David Demaree`;
const description = unavailable
  ? 'Content is temporarily unavailable. Please try again shortly.'
  : topic?.data.description ?? 'This topic does not exist.';
---

<BaseLayout title={title} description={description}>
  <main id="main" class="index-shell">
    <header class="index-header">
      <p class="index-eyebrow">
        <a href="/topics/">Topics</a>
      </p>
      <h1>{heading}</h1>
      {(topic || unavailable) && <p class="index-lede">{description}</p>}
    </header>

    {topic && !unavailable && <PostIndex posts={posts} topics={topics} label={topic.data.title} />}
  </main>
</BaseLayout>
