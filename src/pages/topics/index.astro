---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getTopics, postTopicId } from '../../lib/taxonomy';

Astro.response.headers.set('Cache-Control', 'no-store');

let topics: Awaited<ReturnType<typeof getTopics>> = [];
let posts: Awaited<ReturnType<typeof getPublishedPosts>> = [];
let unavailable = false;
try {
  [topics, posts] = await Promise.all([getTopics(), getPublishedPosts()]);
} catch (error) {
  console.error('Unable to load topic index from EmDash.', error);
  Astro.response.status = 503;
  unavailable = true;
}
const counts = new Map<string, number>();
for (const post of posts) {
  const id = postTopicId(post);
  counts.set(id, (counts.get(id) ?? 0) + 1);
}
---

<BaseLayout
  title="Topics — David Demaree"
  description="Mini-blogs and other collections of writing by David Demaree."
>
  <main id="main" class="index-shell">
    <header class="index-header">
      <p class="index-eyebrow">Index</p>
      <h1>Topics</h1>
      <p class="index-lede">{unavailable ? 'Content is temporarily unavailable. Please try again shortly.' : 'A few curated collections, including mini-blogs that live in the site navigation.'}</p>
    </header>

    <section class="taxonomy-index" aria-label="Topics">
      {topics.map((topic) => (
        <article class="taxonomy-card">
          <h2><a href={`/topics/${topic.id}/`}>{topic.data.title}</a></h2>
          <p>{topic.data.description}</p>
          <p class="taxonomy-card__meta">{counts.get(topic.id) ?? 0} posts</p>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>
