---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchiveHeader from '../../components/ArchiveHeader.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getPublishedPosts, getTopics, postTopicId } from '../../lib/taxonomy';

Astro.response.headers.set('Cache-Control', 'no-store');

let topics: Awaited<ReturnType<typeof getTopics>> = [];
let posts: Awaited<ReturnType<typeof getPublishedPosts>> = [];
let unavailable = false;
try {
  [topics, posts] = await Promise.all([getTopics(), getPublishedPosts()]);
} catch (error) {
  console.error('Unable to load topic index from EmDash.', error);
  Astro.response.status = 503;
  unavailable = true;
}
const counts = new Map<string, number>();
for (const post of posts) {
  const id = postTopicId(post);
  counts.set(id, (counts.get(id) ?? 0) + 1);
}
---

<BaseLayout
  title="Topics — David Demaree"
  description="Mini-blogs and other collections of writing by David Demaree."
>
  <main id="main" class="content-inset archive-page">
    <ArchiveHeader heading="Topics" current="topics" message={unavailable ? 'Content is temporarily unavailable. Please try again shortly.' : undefined} />

    <section class="taxonomy-index" aria-label="Topics">
      {topics.map((topic) => (
        <article class="taxonomy-card">
          <a href={`/topics/${topic.id}/`}>
            <h2>{topic.data.title}</h2>
            <p>{topic.data.description}</p>
            <span class="taxonomy-card__meta">{counts.get(topic.id) ?? 0} posts</span>
            <span class="arrow" aria-hidden="true"></span>
          </a>
        </article>
      ))}
    </section>
    {!unavailable && <NewsletterSignup />}
  </main>
</BaseLayout>
