---
import { decodeSlug } from 'emdash';
import sidebarImage from '../../assets/images/site/bits-and-letters.png';
import bookImage from '../../assets/images/site/git-for-humans.webp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmDashContent from '../../components/EmDashContent.astro';
import { documentUri } from '../../lib/standard-site';
import {
  formatDate,
  getPostForPage,
  getPublishedPosts,
  postTagSlugs,
  type PostEntry,
  type PostPageEntry,
  type TopicEntry,
} from '../../lib/taxonomy';
import { emdashPostUrl, emdashSocialImage } from '../../lib/emdash-post';
import SidebarPromo from '@/components/blog/SidebarPromo.astro';

export const prerender = false;

let slug: string | undefined;
try {
  slug = decodeSlug(Astro.params.slug);
} catch {
  // Malformed URL encoding is a missing route, not a CMS outage.
}
if (!slug || slug.includes('/')) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
let post: PostPageEntry | undefined;
let posts: PostEntry[];
let topic: TopicEntry | undefined;
let isPreview = false;
try {
  // Lists remain public; only EmDash's validated preview/edit context can
  // select the pending revision for this single post.
  const [page, publishedPosts] = await Promise.all([getPostForPage(slug), getPublishedPosts()]);
  ({ post, topic, isPreview } = page);
  posts = publishedPosts;
} catch (error) {
  console.error('[EmDash] Failed to load public post:', error);
  return new Response('This post is temporarily unavailable. Please try again soon.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

if (!post) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
  Astro.response.headers.set('X-Robots-Tag', 'noindex');
}

const position = posts.findIndex((entry) => entry.id === post.id);
const newerPost = position > 0 ? posts[position - 1] : undefined;
const olderPost = position >= 0 ? posts[position + 1] : undefined;

// Generate standard.site document AT-URI if DID is configured.
const standardDid = import.meta.env.STANDARD_SITE_DID;
const standardDocumentUri = standardDid ? documentUri(standardDid, post.id) : undefined;
const publishedAt = post.data.publishedAt ? formatDate(post.data.publishedAt) : undefined;
const tags = postTagSlugs(post);
const image = emdashSocialImage(post.data.featured_image, Astro.locals.emdash?.getPublicMediaUrl, Astro.url.origin);
---

<BaseLayout
  title={`${post.data.title} — David Demaree`}
  description={post.data.description}
  type="article"
  image={image}
  imageAlt={post.data.featured_image_alt ?? post.data.featured_image?.alt}
  publishedAt={isPreview ? undefined : post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  standardDocumentUri={standardDocumentUri}
  noindex={isPreview}
>
  <main id="main" class="single-post">
    <article>
      <header class="entry-header">
        <nav class="entry-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          {topic && (
            <>
              <span aria-hidden="true">/</span>
              <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>
            </>
          )}
        </nav>
        {isPreview && <p class="entry-preview-notice" role="status">Preview — this view may include unpublished changes.</p>}
        <h1 {...post.edit.title}>{post.data.title}</h1>
        {post.data.subtitle && <p class="entry-subtitle" {...post.edit.subtitle}>{post.data.subtitle}</p>}
        {publishedAt && <time datetime={post.data.publishedAt?.toISOString()}>{publishedAt}</time>}
        {post.data.link_url && (
          <p class="entry-external-link">
            <a href={post.data.link_url} rel="noopener noreferrer">
              View original link
            </a>
          </p>
        )}
      </header>

      <div class="entry-layout">
        <div class="entry-main">
          <div class="prose flow">
            <EmDashContent post={post} />
          </div>
        </div>

        <aside class="entry-sidebar" aria-label="Post sidebar">
          {(topic || tags.length > 0) && (
            <nav class="article-taxonomies" aria-label="Post topics and tags">
              {topic && (
                <div class="article-taxonomies__row">
                  <span>Filed in</span>
                  <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>
                </div>
              )}
              {tags.length > 0 && (
                <div class="article-taxonomies__row">
                  <span>Tagged</span>
                  <ul aria-label="Tags">
                    {tags.map(({ tag, slug }) => (
                      <li>
                        <a href={`/labels/${slug}/`}>{tag}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </nav>
          )}

          <SidebarPromo image={sidebarImage} imageAlt="Bits&Letters" href="https://www.bitsandletters.com/">
            <span><strong>Websites and apps made with clarity and craft.</strong> Bits&amp;Letters is a little consultancy for all your biggest digital problems.</span>
          </SidebarPromo>

          <SidebarPromo image={bookImage} imageAlt="Git for Humans book cover" href="https://gitforhumans.us/">
            <span><strong>Git for Humans.</strong> My friendly guide to Git, from your first commit to branches and merge conflicts.</span>
            <span class="sidebar-promo__cta">Get the book <span aria-hidden="true">→</span></span>
          </SidebarPromo>
        </aside>
      </div>

      {(olderPost || newerPost) && (
        <nav class="post-navigation" aria-label="More posts">
          {olderPost && (
            <a href={emdashPostUrl(olderPost)}>
              <span class="post-navigation__label">← Previous post</span>
              <strong>{olderPost.data.title}</strong>
              <time>{formatDate(olderPost.data.publishedAt)}</time>
            </a>
          )}
          {newerPost && (
            <a class="post-navigation__next" href={emdashPostUrl(newerPost)}>
              <span class="post-navigation__label">Next post →</span>
              <strong>{newerPost.data.title}</strong>
              <time>{formatDate(newerPost.data.publishedAt)}</time>
            </a>
          )}
        </nav>
      )}
    </article>
  </main>
</BaseLayout>
