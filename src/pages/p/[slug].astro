---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import sidebarImage from '../../assets/images/site/bits-and-letters.png';
import bookImage from '../../assets/images/site/git-for-humans.webp';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getTopic, postTopicId, slugifyTag } from '../../lib/taxonomy';
import { getPostDescription } from '../../lib/post-description';

import SidebarPromo from '@/components/blog/SidebarPromo.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf(),
  );

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newerPost: index > 0 ? posts[index - 1] : undefined,
      olderPost: index < posts.length - 1 ? posts[index + 1] : undefined,
    },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  newerPost?: CollectionEntry<'posts'>;
  olderPost?: CollectionEntry<'posts'>;
}

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await render(post);
const publishedAt = formatDate(post.data.publishedAt);
const topic = await getTopic(postTopicId(post));
const tags = post.data.tags.map((tag) => ({ tag, slug: slugifyTag(tag) }));
---

<BaseLayout
  title={`${post.data.title} — David Demaree`}
  description={getPostDescription(post)}
  type="article"
  image={post.data.featuredImage}
  imageAlt={post.data.featuredImageAlt}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
>
  <main id="main" class="single-post">
    <article>
      <header class="entry-header">
        <nav class="entry-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/blog/">Blog</a>
          {topic && (
            <>
              <span aria-hidden="true">/</span>
              <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>
            </>
          )}
        </nav>
        <h1>{post.data.title}</h1>
        {post.data.subtitle && <p class="entry-subtitle">{post.data.subtitle}</p>}
        <time datetime={post.data.publishedAt.toISOString()}>{publishedAt}</time>
        {post.data.linkUrl && (
          <p class="entry-external-link">
            <a href={post.data.linkUrl} rel="noopener noreferrer">
              View original link
            </a>
          </p>
        )}
      </header>

      <div class="entry-layout">
        <div class="entry-main">
          <div class="prose flow">
            <Content />
          </div>
        </div>

        <aside class="entry-sidebar" aria-label="Post sidebar">
          {(topic || tags.length > 0) && (
            <nav class="article-taxonomies" aria-label="Post topics and tags">
              {topic && (
                <div class="article-taxonomies__row">
                  <span>Filed in</span>
                  <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>
                </div>
              )}
              {tags.length > 0 && (
                <div class="article-taxonomies__row">
                  <span>Tagged</span>
                  <ul aria-label="Tags">
                    {tags.map(({ tag, slug }) => (
                      <li>
                        <a href={`/labels/${slug}/`}>{tag}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </nav>
          )}

          <SidebarPromo image={sidebarImage} imageAlt="Bits&Letters" href="https://www.bitsandletters.com/">
            <span><strong>Websites and apps made with clarity and craft.</strong> Bits&amp;Letters is a little consultancy for all your biggest digital problems.</span>
          </SidebarPromo>

          <SidebarPromo image={bookImage} imageAlt="Git for Humans book cover" href="https://gitforhumans.us/">
            <span><strong>Git for Humans.</strong> My friendly guide to Git, from your first commit to branches and merge conflicts.</span>
            <span class="sidebar-promo__cta">Get the book <span aria-hidden="true">→</span></span>
          </SidebarPromo>
        </aside>
      </div>

      {(olderPost || newerPost) && (
        <nav class="post-navigation" aria-label="More posts">
          {olderPost && (
            <a href={`/p/${olderPost.id}/`}>
              <span class="post-navigation__label">← Previous post</span>
              <strong>{olderPost.data.title}</strong>
              <time>{formatDate(olderPost.data.publishedAt)}</time>
            </a>
          )}
          {newerPost && (
            <a class="post-navigation__next" href={`/p/${newerPost.id}/`}>
              <span class="post-navigation__label">Next post →</span>
              <strong>{newerPost.data.title}</strong>
              <time>{formatDate(newerPost.data.publishedAt)}</time>
            </a>
          )}
        </nav>
      )}
    </article>
  </main>
</BaseLayout>
