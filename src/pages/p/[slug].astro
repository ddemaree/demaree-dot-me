---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EmDashContent from '../../components/EmDashContent.astro';
import { documentUri } from '../../lib/standard-site';
import {
  formatDate,
  getPostForPage,
  getPublishedPosts,
  postTagSlugs,
  type PostEntry,
  type PostPageEntry,
  type TopicEntry,
} from '../../lib/taxonomy';
import { withBitsAndLettersUtm } from '../../lib/bits-and-letters-utm.mjs';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { emdashPostSlug, emdashPostUrl } from '../../lib/emdash-post';
import { postSocialImage } from '../../lib/social-images';

export const prerender = false;

const slug = emdashPostSlug(Astro.params.slug);
if (!slug) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
let post: PostPageEntry | undefined;
let posts: PostEntry[];
let topic: TopicEntry | undefined;
let isPreview = false;
try {
  // Lists remain public; only EmDash's validated preview/edit context can
  // select the pending revision for this single post.
  const [page, publishedPosts] = await Promise.all([getPostForPage(slug), getPublishedPosts()]);
  ({ post, topic, isPreview } = page);
  posts = publishedPosts;
} catch (error) {
  console.error('[EmDash] Failed to load public post:', error);
  return new Response('This post is temporarily unavailable. Please try again soon.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8' },
  });
}

if (!post) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const position = posts.findIndex((entry) => entry.id === post.id);
const newerPost = position > 0 ? posts[position - 1] : undefined;
const olderPost = position >= 0 ? posts[position + 1] : undefined;

// Generate standard.site document AT-URI if DID is configured.
const standardDid = import.meta.env.STANDARD_SITE_DID;
const standardDocumentUri = standardDid ? documentUri(standardDid, post.id) : undefined;
const publishedAt = post.data.publishedAt ? formatDate(post.data.publishedAt) : undefined;
const tags = postTagSlugs(post);
---

<BaseLayout
  title={`${post.data.title} — David Demaree`}
  description={post.data.description}
  type="article"
  image={isPreview ? undefined : postSocialImage(post.id)}
  imageAlt={isPreview ? undefined : `${post.data.title} — David Demaree`}
  publishedAt={isPreview ? undefined : post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  standardDocumentUri={standardDocumentUri}
  noindex={isPreview}
>
  <main id="main" class="single-post content-inset">
    <article class="article-content">
      <header class="entry-header">
        {isPreview && <p class="entry-preview-notice" role="status">Preview — this view may include unpublished changes.</p>}
        <h1 {...post.edit.title}>{post.data.title}</h1>
        {post.data.subtitle
          ? <p class="entry-subtitle" {...post.edit.subtitle}>{post.data.subtitle}</p>
          : post.data.description && <p class="entry-subtitle">{post.data.description}</p>}
        {publishedAt && <time datetime={post.data.publishedAt?.toISOString()}>{publishedAt}</time>}
        {post.data.link_url && (
          <p class="entry-external-link">
            <a href={withBitsAndLettersUtm(post.data.link_url, 'post-original')} rel="noopener noreferrer">
              View original link
            </a>
          </p>
        )}
      </header>

      <div class="entry-main">
        <div class="prose flow">
          <EmDashContent post={post} />
        </div>
      </div>

      {(topic || tags.length > 0) && (
        <nav class="article-classification" aria-label="Post topics and tags">
          {topic && <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>}
          {tags.map(({ tag, slug }) => <a href={`/labels/${slug}/`}>{tag}</a>)}
        </nav>
      )}

      {(olderPost || newerPost) && (
        <nav class="post-navigation" aria-label="More posts">
          {olderPost && (
            <a href={emdashPostUrl(olderPost)}>
              <span class="post-navigation__label"><span class="arrow arrow--back" aria-hidden="true"></span>Previous post</span>
              <strong>{olderPost.data.title}</strong>
              <time datetime={olderPost.data.publishedAt.toISOString()}>{formatDate(olderPost.data.publishedAt)}</time>
            </a>
          )}
          {newerPost && (
            <a class="post-navigation__next" href={emdashPostUrl(newerPost)}>
              <span class="post-navigation__label">Next post<span class="arrow" aria-hidden="true"></span></span>
              <strong>{newerPost.data.title}</strong>
              <time datetime={newerPost.data.publishedAt.toISOString()}>{formatDate(newerPost.data.publishedAt)}</time>
            </a>
          )}
        </nav>
      )}
    </article>
    <NewsletterSignup />
  </main>
</BaseLayout>
