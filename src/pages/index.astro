---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import BnlPostCollection from "../components/BnlPostCollection.astro";
import LocalPostCollection from "@/components/LocalPostCollection.astro";

import ddPixelPortrait from '@/assets/images/site/dd-pixel-portrait-edited.png'

---

<BaseLayout
  title="David Demaree — A good man, and thorough."
  description="David Demaree is a web designer, engineer, and systems thinker."
>
  <main id="main" class="home-page">
    <div class="container mx-auto">
      <section class="home-intro" aria-labelledby="home-intro-heading">
        <div class="home-intro__container py-[1lh] flex flex-col lg:flex-row max-w-4xl mx-auto items-center">
          <figure class="max-w-50">
            <Image src={ddPixelPortrait} alt="David Demaree" class="home-intro__image" layout="constrained" width={400} />
          </figure>
          <h1 id="home-intro-heading" class="home-intro__heading text-balance font-serif mt-[0.5lh] text-center max-w-[40ch]">
            <strong>David Demaree</strong> is a <span>software product leader</span>, <span>web designer</span>, <span>developer</span>, and <span>author</span>.
          </h1>
        </div>
      </section>

      <LocalPostCollection />

      <hr class="my-10" />

      <BnlPostCollection title="Recent posts from the Bits&Letters blog" server:defer>
        <section slot="fallback" class="py-10 max-w-5xl mx-auto" aria-labelledby="bnl-posts-loading-heading">
          <h2 id="bnl-posts-loading-heading" class="text-2xl/none font-medium">Recent posts from the Bits&amp;Letters blog</h2>
          <p class="mt-6 text-current/70">Loading posts…</p>
        </section>
      </BnlPostCollection>
    </div>

  </main>
</BaseLayout>

<style is:global>
  @reference '@/styles/theme.css';

  @layer components {

    .home-page {
      --home-color-bg: var(--home-background);
      --home-color-fg: var(--home-accent);

      background-color: var(--home-color-bg);
      color: var(--text);
      min-height: calc(100vh - var(--header-height));
      padding: 1.5rem max(1.75rem, 5vw);
      padding-block-start: 3rem;
    }

    .home-intro {
      @apply flex items-center;
      min-height: 40vh;
    }

    .home-intro__container {
      width: 100%;
      container-type: inline-size;
      container-name: home-intro__copy;
    }

    .home-intro__image {
      border-radius: 100%;
    }

    .home-intro__heading {
      color: var(--home-muted);
      font-size: clamp(28px, 10cqi, 40px);
      font-weight: 420;
      line-height: 1.1;
      margin: 0;
      width: 100%;
      max-width: 32ch !important;

      strong {
        color: var(--text);
        font-weight: 600;
      }
    }

    @variant lg {
    }
  }

</style>
