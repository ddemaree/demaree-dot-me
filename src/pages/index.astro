---
import { Image } from "astro:assets";
import portrait from "../assets/images/site/dd-dithered.png";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="David Demaree — A good man, and thorough."
  description="David Demaree is a web designer, engineer, and systems thinker."
>
  <main id="main" class="home-page">
    <section class="home-intro" aria-labelledby="home-intro-heading">
      <div class="home-intro__container">
        <div class="home-portrait">
          <Image
            class="home-portrait__img"
            src={portrait}
            alt="Pixelated portrait of David Demaree wearing sunglasses, in a stylized blue and pink halftone effect"
            width={400}
            height={400}
            loading="eager"
          />
        </div>
        <div class="home-intro__copy">
          <h1 id="home-intro-heading">
            I’m <strong class="text-nowrap">David Demaree</strong>, a <span
              class="text-nowrap">web designer</span
            >, <span class="text-nowrap">software engineer</span>, and systems
            thinker.
          </h1>
          <p>
            Welcome to Gitea, where we are committed to delivering cutting-edge
            solutions to streamline your development process.
          </p>
          <!-- <a class="button" href="/about/">
            More about me
          </a> -->
        </div>
      </div>
    </section>
  </main>
  <div slot="footer"></div>
</BaseLayout>

<style is:global>
  @reference '@/styles/theme.css';

  /* Home */
  .home-page {
    --home-color-bg: #2d364a;
    --home-color-fg: #ffb1a5;
    min-height: calc(100vh - var(--header-height));
    padding: 1.5rem;

    background-color: color-mix(in oklab, var(--home-color-bg), black 15%);
    color: contrast-color(var(--home-color-bg));

    @variant md {
      padding-block-start: 3rem;
    }
  }

  .home-intro {
    display: flex;
    width: min(100%, 68rem);
    margin-inline: auto;
  }

  .home-intro__container {
    display: grid;
    grid-template-columns: 1fr;
    width: 100%;
    row-gap: 2.5rem;
    align-items: start;

    max-width: 36rem;
    margin-inline: auto;

    @variant lg {
      grid-template-columns: 25rem 1fr;
      max-width: none;
    }
  }

  .home-portrait {
    /*width: min(25rem, calc(100vw - 5rem));*/
    /*width: 100%;*/
    margin-inline: -1.5rem;
    margin-block-start: -1.5rem;
    max-width: 100vw;

    img {
      @apply size-full object-cover aspect-4/3;
    }

    @variant sm {
      margin: 0;
      max-width: 20rem;
    }

    @variant md {
      aspect-ratio: 1;
    }

    @variant lg {
      max-width: none;
      display: flex;
      justify-content: end;

      img {
        width: 500px;
        height: 500px;
        max-width: none;
      }
    }
  }

  .home-intro__copy {
    color: #ffb1a5;
    container-type: inline-size;
    container-name: home-intro__copy;
    width: 100%;

    font-family: gt-maru-mono-vf;
    font-size: clamp(24px, 2.25cqi, 99px);
    line-height: 1.5;
    letter-spacing: -0.03em;

    @variant lg {
      padding-inline-start: 5cqi;
    }

    > * + * {
      margin-block-start: 0.75lh;
    }

    h1 {
      margin: 0;
      font-weight: 390;
      width: 100%;

      &:before {
        content: "# ";
      }
    }

    strong {
      color: white;
      font-weight: 480;
    }
  }
</style>
