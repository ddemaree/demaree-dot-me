# standard.site AT Protocol credentials
# After filling in, run: pnpm standard:publish --create-publication

# Your Bluesky handle
STANDARD_SITE_HANDLE=demar.ee

# App password generated in Bluesky Settings → App Passwords
# Create a new password for "standard.site"
STANDARD_SITE_APP_PASSWORD=

# Your DID (did:plc:...) — resolved on first login, set here to cache
STANDARD_SITE_DID=

# AT-URI of the publication record — created by --create-publication
STANDARD_SITE_PUBLICATION_URI=
